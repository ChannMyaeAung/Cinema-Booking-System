# Copy to .env and fill in values. Never commit .env (see .gitignore).
# Get your secret key from the Clerk dashboard (https://dashboard.clerk.com → API Keys → Secret keys).
CLERK_SECRET_KEY=
# Admin accounts: mark staff users in the Clerk dashboard (Users → edit user →
# Metadata → public_metadata → {"role": "admin"}). No env/restart needed.

# Stripe payment. Secret key from the Stripe dashboard (Developers → API keys).
# Webhook secret comes from `stripe listen --forward-to localhost:8080/stripe/webhook`
# (local dev) or from your configured webhook endpoint (production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
